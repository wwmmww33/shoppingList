# AI features (auto category, category suggestions, brand-photo reading).
# Set ONE provider's key. With both set, AI_PROVIDER picks (default: gemini).

# Google Gemini — free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Optional: gemini | deepseek
AI_PROVIDER=
