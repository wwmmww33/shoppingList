<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= list.title %> - قوائمنا</title>
    <link rel="stylesheet" href="/style.css">
    <%- include('partials/theme-init') %>
</head>
<body>
    <%- include('partials/nav') %>
    <div class="container">
        <div class="card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h2 style="margin:0;">
                <%= list.title %>
                <% if (isPinned) { %><span class="badge" title="مثبتة في الصفحة الرئيسية"><i data-lucide="pin" class="lucide"></i></span><% } %>
            </h2>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <%- include('partials/list-header-buttons', { isOwner: isOwner, shares: shares }) %>
                <form method="POST" action="/lists/<%= isPinned ? 'unpin' : (list.id + '/pin') %>" style="display:inline;">
                    <button type="submit" class="btn btn-outline btn-sm"><i data-lucide="pin" class="lucide"></i> <%= isPinned ? 'إلغاء التثبيت' : 'تثبيت في الرئيسية' %></button>
                </form>
                <% if (isOwner) { %>
                    <%# Rename + delete live in the settings modal, not the header,
                        so deleting the list can't happen from a stray tap. %>
                    <button type="button" class="icon-btn" title="إعدادات القائمة" onclick="toggleListSettings()"><i data-lucide="settings" class="lucide"></i></button>
                <% } %>
            </div>
        </div>

        <div id="items-list-root">
        <%- include('partials/items-list', {
            listId: list.id,
            isOwner: isOwner,
            activeItems: activeItems,
            archivedItems: archivedItems,
            stores: stores,
            availableLists: availableLists,
            knownItemNames: knownItemNames,
            weekdayNames: weekdayNames,
            itemCategories: itemCategories,
            storeCategories: storeCategories,
            units: units,
            isSharedList: isSharedList,
            redirectTo: ('/lists/' + list.id)
        }) %>
        </div>
    </div>

    <%- include('partials/list-modals', { list: list, isOwner: isOwner, shares: shares, shoppingHistory: shoppingHistory, stores: stores, returnTo: '/lists/' + list.id }) %>

    <% if (isOwner) { %>
    <div class="modal-overlay" id="list-settings-modal" onclick="if (event.target === this) toggleListSettings()">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3>إعدادات القائمة</h3>
                <button type="button" class="icon-btn" title="إغلاق" onclick="toggleListSettings()"><i data-lucide="x" class="lucide"></i></button>
            </div>
            <form method="POST" action="/lists/<%= list.id %>/rename" class="inline-form">
                <label class="field">اسم القائمة
                    <input type="text" name="title" value="<%= list.title %>" required>
                </label>
                <button type="submit" class="btn btn-success btn-sm">حفظ الاسم</button>
            </form>

            <%# Deleting needs the list's exact name typed first (on top of the
                confirm), so it can't be done by accident. %>
            <div class="danger-zone">
                <h4><i data-lucide="triangle-alert" class="lucide"></i> حذف القائمة</h4>
                <p>يحذف القائمة وكل أغراضها وسجل مشترياتها نهائيًا، ولا يمكن التراجع عنه.</p>
                <form method="POST" action="/lists/<%= list.id %>/delete" class="inline-form" onsubmit="return confirm('حذف القائمة وكل محتوياتها نهائيًا؟');">
                    <label class="field">للتأكيد اكتب اسم القائمة: <strong><%= list.title %></strong>
                        <input type="text" id="delete-list-confirm" autocomplete="off" data-title="<%= list.title %>" oninput="document.getElementById('delete-list-btn').disabled = this.value.trim() !== this.dataset.title.trim();">
                    </label>
                    <button type="submit" class="btn btn-danger btn-sm" id="delete-list-btn" disabled>حذف القائمة نهائيًا</button>
                </form>
            </div>
        </div>
    </div>
    <% } %>

    <script>
        function toggleListSettings() {
            var el = document.getElementById('list-settings-modal');
            if (!el) return;
            el.classList.toggle('open');
            // Always reopen with the delete confirmation cleared and locked.
            var confirmInput = document.getElementById('delete-list-confirm');
            if (confirmInput) confirmInput.value = '';
            var btn = document.getElementById('delete-list-btn');
            if (btn) btn.disabled = true;
        }
    </script>
</body>
</html>
