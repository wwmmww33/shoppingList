<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سجل شراء <%= item.name %> - قوائمنا</title>
    <link rel="stylesheet" href="/style.css">
    <%- include('partials/theme-init') %>
</head>
<body>
    <%- include('partials/nav') %>
    <div class="container">
        <div class="card">
            <a href="/lists/<%= list.id %>">&larr; رجوع للقائمة</a>
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-top:10px;">
                <h2 style="margin:0;">سجل شراء: <%= item.name %></h2>
                <a href="/items/<%= item.id %>/history<%= order === 'desc' ? '?order=asc' : '' %>" class="btn btn-outline btn-sm" title="عكس الترتيب">
                    <i data-lucide="arrow-up-down" class="lucide"></i> <%= order === 'desc' ? 'الأحدث أولًا' : 'الأقدم أولًا' %>
                </a>
            </div>
        </div>

        <%# Price comparison: one block per exact product (same brand + same
            details), compared across stores and over time — see
            buildPriceComparison in routes/lists.js. %>
        <% if (comparison.length > 0) { %>
        <% const fmtDate = function(d) { return String(d).split('-').reverse().join('-'); }; %>
        <div class="card">
            <h3 style="margin:0 0 4px;"><i data-lucide="scale" class="lucide"></i> مقارنة الأسعار</h3>
            <p class="history-sub" style="margin:0 0 10px;">لنفس البراند بنفس التفاصيل — سعر الوحدة بين المحلات ومع الوقت.</p>
            <% comparison.forEach(function(g) { %>
                <div class="compare-group">
                    <div class="compare-title">
                        <strong><%= g.brand || g.detail %></strong>
                        <% if (g.brand && g.detail) { %><span class="history-sub"><%= g.detail %></span><% } %>
                    </div>

                    <div class="compare-stores">
                        <% g.stores.forEach(function(s) { %>
                            <div class="compare-store <%= s.cheapest ? 'cheapest' : '' %>">
                                <div class="compare-store-name">
                                    <i data-lucide="store" class="lucide"></i> <%= s.storeName %>
                                    <% if (s.cheapest) { %><span class="compare-badge">الأرخص</span><% } %>
                                </div>
                                <div class="compare-store-price"><%= Number(s.lastPrice).toFixed(3) %></div>
                                <div class="history-sub compare-store-meta">
                                    آخر شراء <%= fmtDate(s.lastDate) %>
                                    <% if (s.count > 1) { %>· <%= s.count %> مرات · أقل سعر <%= Number(s.minPrice).toFixed(3) %><% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <% if (g.timeline.length > 1) { %>
                        <%# Only the most recent few, so a weekly item's timeline doesn't
                            grow without end (the full list is in the table below). %>
                        <% const TIMELINE_MAX = 8; %>
                        <% if (g.timeline.length > TIMELINE_MAX) { %><p class="history-sub" style="margin:8px 0 0;">آخر <%= TIMELINE_MAX %> عمليات شراء:</p><% } %>
                        <div class="compare-timeline">
                            <% g.timeline.slice(-TIMELINE_MAX).forEach(function(t) { %>
                                <span class="compare-point">
                                    <span class="history-sub"><%= fmtDate(t.date) %> · <%= t.storeName %></span>
                                    <strong><%= Number(t.price).toFixed(3) %></strong>
                                    <% if (t.changePct !== undefined && t.changePct !== 0) { %>
                                        <%# dir="ltr" keeps "+50%" / "-40%" from being flipped by the RTL text around it. %>
                                        <span class="compare-change <%= t.changePct > 0 ? 'up' : 'down' %>"><%= t.changePct > 0 ? '▲' : '▼' %> <span dir="ltr"><%= t.changePct > 0 ? '+' : '' %><%= t.changePct %>%</span></span>
                                    <% } else if (t.changePct === 0) { %>
                                        <span class="compare-change same">= بدون تغيير</span>
                                    <% } %>
                                </span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="history-sub" style="margin:6px 0 0;">عملية شراء واحدة فقط حتى الآن — تظهر المقارنة عند شرائه مرة أخرى.</p>
                    <% } %>
                </div>
            <% }) %>
        </div>
        <% } %>

        <div class="card">
            <% if (purchases.length === 0) { %>
                <p style="color: var(--text-muted);">لا يوجد سجل شراء لهذا الغرض بعد.</p>
            <% } else { %>
                <%
                let cheapestId = null;
                const priced = purchases.filter(p => p.price !== null);
                if (priced.length > 0) {
                    cheapestId = priced.reduce((min, p) => (p.price < min.price ? p : min), priced[0]).id;
                }
                %>
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>المحل</th>
                            <th>البراند</th>
                            <th>التفاصيل</th>
                            <th>سعر الوحدة</th>
                            <th>الكمية</th>
                            <th>الإجمالي</th>
                            <th>بواسطة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% purchases.forEach(function(p) { %>
                            <%# data-label: the column name, shown beside each value when
                                the table collapses into one card per purchase on phones. %>
                            <tr class="<%= p.id === cheapestId ? 'best' : '' %>">
                                <td data-label="التاريخ">
                                    <%= String(p.bought_at).slice(0, 10).split('-').reverse().join('-') %>
                                    <div class="history-sub"><%= String(p.bought_at).slice(11, 16) %></div>
                                </td>
                                <td data-label="المحل"><%= p.store_name || '-' %></td>
                                <td data-label="البراند">
                                    <% if (p.brand_image) { %><img src="<%= p.brand_image %>" class="brand-thumb brand-thumb-sm" alt="" onclick="openImageLightbox(this.src)"><% } %>
                                    <%= p.brand || '-' %>
                                </td>
                                <td data-label="التفاصيل"><%= p.brand_detail || '-' %></td>
                                <td data-label="سعر الوحدة"><%= p.price !== null ? Number(p.price).toFixed(3) : '-' %></td>
                                <td data-label="الكمية"><%= p.purchased_qty !== null ? p.purchased_qty : '1 (افتراضي)' %></td>
                                <td data-label="الإجمالي"><%= p.price !== null ? (Number(p.price) * (p.purchased_qty !== null ? p.purchased_qty : 1)).toFixed(3) : '-' %></td>
                                <td data-label="بواسطة"><%= p.buyer_name || 'مستخدم سابق' %></td>
                                <td class="history-actions">
                                    <button type="button" class="icon-btn" title="تعديل"
                                        onclick="openEditPurchaseModal(<%= JSON.stringify({ id: p.id, storeId: p.store_id || '', brand: p.brand || '', detail: p.brand_detail || '', price: p.price !== null ? p.price : '', qty: p.purchased_qty !== null ? p.purchased_qty : '', date: String(p.bought_at || '').slice(0, 10), time: String(p.bought_at || '').slice(11, 16), image: p.brand_image || '' }) %>)">
                                        <i data-lucide="pencil" class="lucide"></i>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% if (cheapestId) { %>
                    <p style="margin-top:10px; font-size:0.85rem; color: var(--text-muted);">الصف الأخضر هو أرخص سعر مُسجَّل.</p>
                <% } %>
            <% } %>
        </div>
    </div>

    <%- include('partials/purchase-edit-modal', { stores: stores, redirectTo: '/items/' + item.id + '/history' + (order === 'asc' ? '?order=asc' : '') }) %>
</body>
</html>
