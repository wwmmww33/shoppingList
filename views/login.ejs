<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - قوائمنا</title>
    <link rel="stylesheet" href="/style.css">
    <%- include('partials/theme-init') %>
</head>
<body>
    <div class="auth-wrap">
        <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" title="تبديل الوضع الليلي" style="align-self:center;"><i data-lucide="moon" class="lucide"></i></button>
        <div class="auth-card">
            <h2><i data-lucide="clipboard-list" class="lucide"></i> قوائمنا</h2>
            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>
            <form method="POST" action="/login">
                <div style="margin-bottom: 12px;">
                    <input type="email" name="email" placeholder="الإيميل" required autofocus>
                </div>
                <div style="margin-bottom: 16px;">
                    <input type="password" name="password" placeholder="كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-block">دخول</button>
            </form>
            <p style="margin-top: 16px; font-size: 0.9rem;">
                ما عندك حساب؟ <a href="/register">إنشاء حساب جديد</a>
            </p>
        </div>
    </div>
</body>
</html>
