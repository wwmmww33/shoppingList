<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حسابي والإعدادات - قوائمنا</title>
    <link rel="stylesheet" href="/style.css?v=<%= styleVersion %>">
    <%- include('partials/theme-init') %>
    <script src="/vendor/sortable-1.15.2.min.js"></script>
</head>
<body>
    <%- include('partials/nav') %>
    <div class="container">
        <div class="card">
            <h3 style="margin-top:0;">بياناتي</h3>
            <p><strong>الاسم:</strong> <%= user.name %></p>
            <p><strong>الإيميل:</strong> <%= user.email %></p>
        </div>

        <div class="card">
            <h3 style="margin-top:0;">تغيير كلمة المرور</h3>
            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="success-box"><%= success %></div>
            <% } %>
            <form method="POST" action="/account/password">
                <div style="margin-bottom: 12px;">
                    <input type="password" name="current_password" placeholder="كلمة المرور الحالية" required>
                </div>
                <div style="margin-bottom: 12px;">
                    <input type="password" name="new_password" placeholder="كلمة المرور الجديدة (6 أحرف على الأقل)" required minlength="6">
                </div>
                <div style="margin-bottom: 16px;">
                    <input type="password" name="confirm_password" placeholder="تأكيد كلمة المرور الجديدة" required minlength="6">
                </div>
                <button type="submit" class="btn btn-success btn-block">حفظ كلمة المرور الجديدة</button>
            </form>
        </div>

        <div class="card">
            <h3 style="margin-top:0;">تصنيفات الأغراض</h3>
            <p style="font-size:0.85rem; color: var(--text-muted); margin-top:-6px;">عدّل اسم أي تصنيف أو أيقونته أو لونه، أو احذفه (تعود أغراضه إلى "بدون تصنيف"). هذا يشمل التصنيفات الأساسية أيضًا.</p>
            <p style="font-size:0.85rem; color: var(--text-muted);"><i data-lucide="grip-vertical" class="lucide"></i> اسحب أي تصنيف من المقبض لتغيير ترتيبه — هذا هو ترتيب ظهور التصنيفات في القوائم وفي "المشتراة والملغاة". يُحفظ تلقائيًا. <span id="category-order-status" class="category-order-status"></span></p>
            <div id="category-sort-list">
            <%# One compact line per category (handle · icon · name · edit · delete);
                the edit fields open below it only when ✏ is tapped. %>
            <% itemCategories.forEach(function(c) { %>
                <div class="category-sort-row" data-id="<%= c.id %>">
                    <div class="category-row-main">
                        <span class="drag-handle" title="اسحب لتغيير الترتيب"><i data-lucide="grip-vertical" class="lucide"></i></span>
                        <i data-lucide="<%= c.icon %>" class="lucide" style="color:<%= c.color %>; flex:0 0 auto;"></i>
                        <span class="category-row-label"><%= c.label %></span>
                        <button type="button" class="icon-btn" title="تعديل" onclick="this.closest('.category-sort-row').classList.toggle('open')"><i data-lucide="pencil" class="lucide"></i></button>
                        <form method="POST" action="/categories/<%= c.id %>/delete" onsubmit="return confirm('حذف هذا التصنيف؟ ستصبح أغراضه بدون تصنيف.');">
                            <input type="hidden" name="redirect_to" value="/account">
                            <button type="submit" class="icon-btn icon-btn-danger" title="حذف"><i data-lucide="trash-2" class="lucide"></i></button>
                        </form>
                    </div>
                    <form method="POST" action="/categories/<%= c.id %>/edit" class="inline-form category-edit-form">
                        <input type="hidden" name="redirect_to" value="/account">
                        <input type="text" name="label" value="<%= c.label %>" required class="flex-2">
                        <div class="form-row">
                            <i data-lucide="<%= c.icon %>" class="lucide cat-icon-preview" style="color:<%= c.color %>; flex:0 0 auto; align-self:center;"></i>
                            <select name="icon" class="flex-1" onchange="var p = this.parentElement.querySelector('.cat-icon-preview'); p.setAttribute('data-lucide', this.value); if (window.renderIcons) renderIcons();">
                                <% customCategoryIcons.forEach(function(ic) { %>
                                    <option value="<%= ic %>" <%= c.icon === ic ? 'selected' : '' %>><%= ic %></option>
                                <% }) %>
                            </select>
                            <input type="color" name="color" value="<%= c.color %>" title="لون التصنيف" style="flex:0 0 auto; width:44px; padding:2px; border:1px solid var(--border); border-radius:6px;">
                            <button type="submit" class="btn btn-success btn-sm">حفظ</button>
                        </div>
                    </form>
                </div>
            <% }) %>
            </div>

            <hr style="border:none; border-top:1px dashed var(--border); margin:16px 0 12px;">
            <h4 style="margin:0 0 8px;">تصنيف جديد</h4>
            <form method="POST" action="/categories" class="inline-form">
                <input type="hidden" name="redirect_to" value="/account">
                <input type="text" name="label" placeholder="اسم التصنيف" required class="flex-2">
                <i data-lucide="package" class="lucide cat-icon-preview" style="flex:0 0 auto;"></i>
                <select name="icon" class="flex-1" onchange="this.previousElementSibling.setAttribute('data-lucide', this.value); if (window.renderIcons) renderIcons();">
                    <% customCategoryIcons.forEach(function(ic) { %>
                        <option value="<%= ic %>"><%= ic %></option>
                    <% }) %>
                </select>
                <input type="color" name="color" value="#43a047" title="لون التصنيف" style="flex:0 0 auto; width:44px; padding:2px; border:1px solid var(--border); border-radius:6px;">
                <button type="submit" class="btn btn-success btn-sm">+ إضافة</button>
            </form>
        </div>

        <div class="card">
            <h3 style="margin-top:0;">اقتراح تصنيفات بالذكاء الاصطناعي</h3>
            <p style="font-size:0.85rem; color: var(--text-muted); margin-top:-6px;">يحلّل الأغراض غير المصنّفة في كل قوائمك (ملكًا أو مشاركة) ويقترح تصنيفات جديدة مناسبة لها.</p>
            <button type="button" class="btn btn-outline btn-sm" onclick="suggestCategoriesGlobally()"><i data-lucide="sparkles" class="lucide"></i> تحليل واقتراح</button>
            <div id="global-category-suggest-body" style="margin-top:10px;"></div>
        </div>

        <div class="card" id="brands">
            <h3 style="margin-top:0;">البراندات</h3>
            <p style="font-size:0.85rem; color: var(--text-muted); margin-top:-6px;">كل البراندات المسجّلة من قبل، مجمّعة حسب تصنيف الغرض — بدون أي تفاصيل أسعار. يمكنك تعديل الاسم/التفاصيل/الصورة، أو نقل براند إلى غرض آخر.</p>
            <%
            const unclassifiedBucket = { key: '', label: 'بدون تصنيف', icon: 'package', color: '#9e9e9e' };
            const brandCategoryList = itemCategories.concat([unclassifiedBucket]);
            let anyBrandsShown = false;
            %>
            <% brandCategoryList.forEach(function(c) { %>
                <% const brands = brandsByCategory[c.key] || []; %>
                <% if (brands.length === 0) { return; } %>
                <% anyBrandsShown = true; %>
                <button type="button" class="collapsible-toggle" onclick="toggleCollapsible('brands-cat-<%= c.key || 'none' %>')">
                    <span><i data-lucide="<%= c.icon %>" class="lucide" style="color:<%= c.color %>;"></i> <%= c.label %> (<%= brands.length %>)</span>
                    <span class="chev">▾</span>
                </button>
                <div class="collapsible-body" id="brands-cat-<%= c.key || 'none' %>" style="margin-bottom:10px;">
                    <% brands.forEach(function(b, idx) { %>
                        <% const rowId = 'brand-' + (c.key || 'none') + '-' + idx; %>
                        <div class="list-row">
                            <span style="display:flex; align-items:center; gap:8px;">
                                <% if (b.image) { %><img src="<%= b.image %>" class="brand-thumb brand-thumb-sm" alt="" onclick="openImageLightbox(this.src)"><% } %>
                                <span>
                                    <strong><%= b.brand || b.detail || 'بدون اسم' %></strong>
                                    <% if (b.brand && b.detail) { %><span class="meta"><%= b.detail %></span><% } %>
                                    <div class="history-sub">تحت: <%= b.itemName %></div>
                                </span>
                            </span>
                            <span style="display:flex; gap:6px;">
                                <button type="button" class="icon-btn" title="تعديل" onclick="toggleBrandRowPanel('<%= rowId %>-edit')"><i data-lucide="pencil" class="lucide"></i></button>
                                <button type="button" class="icon-btn" title="نقل لغرض آخر" onclick="toggleBrandRowPanel('<%= rowId %>-move')"><i data-lucide="move" class="lucide"></i></button>
                            </span>
                        </div>
                        <form method="POST" action="/brands/edit" enctype="multipart/form-data" class="edit-panel" id="<%= rowId %>-edit">
                            <input type="hidden" name="item_name" value="<%= b.itemName %>">
                            <input type="hidden" name="brand" value="<%= b.brand || '' %>">
                            <input type="hidden" name="detail" value="<%= b.detail || '' %>">
                            <input type="text" name="new_brand" value="<%= b.brand || '' %>" placeholder="اسم البراند" class="flex-1">
                            <input type="text" name="new_detail" value="<%= b.detail || '' %>" placeholder="التفاصيل" class="flex-1">
                            <label class="btn btn-outline btn-sm" style="cursor:pointer; flex:0 0 auto; display:inline-flex; align-items:center; gap:4px;">
                                <i data-lucide="image" class="lucide"></i> تغيير الصورة
                                <input type="file" name="brand_image" accept="image/*" style="display:none;">
                            </label>
                            <button type="submit" class="btn btn-success btn-sm">حفظ</button>
                        </form>
                        <form method="POST" action="/brands/move" class="move-panel" id="<%= rowId %>-move">
                            <input type="hidden" name="item_name" value="<%= b.itemName %>">
                            <input type="hidden" name="brand" value="<%= b.brand || '' %>">
                            <input type="hidden" name="detail" value="<%= b.detail || '' %>">
                            <select name="target_item_name" class="flex-1">
                                <% allItemNames.filter(function(n) { return n !== b.itemName; }).forEach(function(n) { %>
                                    <option value="<%= n %>"><%= n %></option>
                                <% }) %>
                            </select>
                            <button type="submit" class="btn btn-success btn-sm">نقل</button>
                        </form>
                    <% }) %>
                </div>
            <% }) %>
            <% if (!anyBrandsShown) { %>
                <p style="color: var(--text-muted);">لا توجد براندات مسجّلة بعد.</p>
            <% } %>
        </div>
    </div>

    <script>
        function toggleBrandRowPanel(id) {
            var el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }
        function suggestCategoriesGlobally() {
            var body = document.getElementById('global-category-suggest-body');
            body.innerHTML = '<p style="color: var(--text-muted); font-size:0.9rem;">جاري التحليل بالذكاء الاصطناعي...</p>';
            fetch('/categories/suggest', { method: 'POST' })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    var suggestions = (data && data.suggestions) || [];
                    var assignedCount = (data && data.assignedCount) || 0;
                    var assignedNote = assignedCount > 0
                        ? '<p style="font-size:0.85rem; color: var(--primary); margin:0 0 10px;"><i data-lucide="sparkles" class="lucide"></i> تم تصنيف ' + assignedCount + ' غرض تلقائيًا ضمن تصنيفات موجودة.</p>'
                        : '';
                    if (suggestions.length === 0) {
                        body.innerHTML = assignedNote || '<p style="color: var(--text-muted); font-size:0.9rem;">لا توجد اقتراحات حاليًا (إما كل الأغراض مصنفة، أو تعذّر التحليل).</p>';
                        if (window.renderIcons) renderIcons();
                        return;
                    }
                    body.innerHTML = assignedNote;
                    suggestions.forEach(function(s) {
                        var card = document.createElement('div');
                        card.className = 'card';
                        card.style.marginBottom = '10px';
                        card.innerHTML =
                            '<div style="display:flex; align-items:center; justify-content:space-between; gap:8px;">' +
                            '<span><i data-lucide="' + s.icon + '" class="lucide"></i> ' + s.label + '</span>' +
                            '<button type="button" class="btn btn-success btn-sm">+ إضافة</button>' +
                            '</div>' +
                            '<p style="font-size:0.82rem; color: var(--text-muted); margin:6px 0 0;">' + s.items.join('، ') + '</p>';
                        card.querySelector('button').onclick = function() {
                            applyGlobalCategorySuggestion(s, card);
                        };
                        body.appendChild(card);
                    });
                    if (window.renderIcons) renderIcons();
                })
                .catch(function() {
                    body.innerHTML = '<p style="color: var(--text-muted); font-size:0.9rem;">تعذّر الاتصال بالذكاء الاصطناعي.</p>';
                });
        }
        function applyGlobalCategorySuggestion(suggestion, cardEl) {
            fetch('/categories/apply-suggestion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ label: suggestion.label, icon: suggestion.icon, itemIds: suggestion.itemIds }),
            })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data && data.ok) {
                        cardEl.remove();
                        window.location.reload();
                    }
                })
                .catch(function() {});
        }

        // Drag-and-drop category order (by the grip handle only, so the
        // name/icon/color fields stay normal to tap and type in). Saved on
        // every drop; a failed save reloads so the page shows the real order.
        (function() {
            var listEl = document.getElementById('category-sort-list');
            var statusEl = document.getElementById('category-order-status');
            if (!listEl || !window.Sortable) return;
            var statusTimer = null;
            function showStatus(text, isError) {
                statusEl.textContent = text;
                statusEl.classList.toggle('error', !!isError);
                clearTimeout(statusTimer);
                if (!isError) statusTimer = setTimeout(function() { statusEl.textContent = ''; }, 2500);
            }
            Sortable.create(listEl, {
                handle: '.drag-handle',
                draggable: '.category-sort-row',
                animation: 150,
                ghostClass: 'category-sort-ghost',
                onEnd: function(evt) {
                    if (evt.oldIndex === evt.newIndex) return;
                    var ids = Array.from(listEl.querySelectorAll('.category-sort-row')).map(function(row) { return Number(row.getAttribute('data-id')); });
                    showStatus('جارٍ الحفظ...');
                    fetch('/categories/reorder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: ids }),
                    })
                        .then(function(res) { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
                        .then(function() { showStatus('✓ تم حفظ الترتيب'); })
                        .catch(function() {
                            showStatus('تعذّر حفظ الترتيب — سيتم تحديث الصفحة', true);
                            setTimeout(function() { window.location.reload(); }, 1500);
                        });
                },
            });
        })();
    </script>
</body>
</html>
